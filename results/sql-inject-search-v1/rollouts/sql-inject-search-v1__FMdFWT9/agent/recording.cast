[29.000139, "o", "\"\"\"\r\napp.py — HR Employee API\r\n\r\nRoutes:\r\n  GET /api/employees          List all employees\r\n  GET /api/employees/<id>     Get employee by ID  (uses execute_raw — legacy)\r\n"]
[29.000526, "o", "  POST /api/employees         Create employee     (uses parameterized execute)\r\n\"\"\"\r\nfrom flask import Flask, jsonify, request, abort\r\nimport db\r\n\r\napp = Flask(__name__)\r\n\r\n@app.route(\"/api/employees\", methods=[\"GET\"])\r\ndef list_employees():\r\n    rows = db.execute(\"SELECT * FROM employees ORDER BY id\")\r\n    return jsonify(rows)\r\n\r\n@app.route(\"/api/employees/<int:emp_id>\", methods=[\"GET\"])\r\ndef get_employee(emp_id):\r\n    rows = db.execute_raw(f\"SELECT * FROM employees WHERE id = {emp_id}\")\r\n    if not rows:\r\n        abort(404)\r\n    return jsonify(rows[0])\r\n\r\n@app.route(\"/api/employees\", methods=[\"POST\"])\r\ndef create_employee():\r\n    data = request.get_json(force=True)\r\n    required = (\"name\", \"department\", \"role\", \"email\")\r\n    if not all(k in data for k in required):\r\n        abort(400)\r\n    db.execute(\r\n        \"INSERT INTO employees (name, department, role, email) VALUES (?, ?, ?, ?)\",\r\n        (data[\"name\"], data[\"department\"], data[\"role\"], data[\"email\"]),\r\n    )\r\n    return jsonify({\"status\": \"created\"}), 201\r\n\r\n@app.route(\"/api/employees/search\", methods=[\"GET\"])\r\ndef search_employees():\r\n    q = request.args.get(\"q\", \"\")\r\n    department = request.args.get(\"department\")\r\n\r\n    sql = \"\"\"\r\n        SELECT id, name, department, role, email\r\n        FROM employees\r\n        WHERE LOWER(name) LIKE ?\r\n    \"\"\"\r\n    params = [f\"%{q.lower()}%\"]\r\n\r\n    if department is not None:\r\n        sql += \" AND department = ?\"\r\n        params.append(department)\r\n\r\n    sql += \" ORDER BY id\"\r\n    rows = db.execute(sql, params)\r\n    return jsonify(rows)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    app.run(host=\"0.0.0.0\", port=5000, debug=False)\r\n"]

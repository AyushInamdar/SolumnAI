[10.641228, "o", "\"\"\"\r\napp.py — HR Employee API\r\n\r\nRoutes:\r\n  GET /api/employees          List all employees\r\n  GET /api/employees/<id>     Get employee by ID  (uses execute_raw — legacy)\r\n  POST /api/employees         Create employee     (uses parameterized execute)\r\n\"\"\"\r\nfrom flask import Flask, jsonify, request, abort\r\nimport db\r\n\r\napp = Flask(__name__)\r\n\r\n@app.route(\"/api/employees\", methods=[\"GET\"])\r\ndef list_employees():\r\n    rows = db.execute(\"SELECT * FROM employees ORDER BY id\")\r\n    return jsonify(rows)\r\n\r\n@app.route(\"/api/employees/<int:emp_id>\", methods=[\"GET\"])\r\ndef get_employee(emp_id):\r\n    rows = db.execute_raw(f\"SELECT * FROM employees WHERE id = {emp_id}\")\r\n    if not rows:\r\n        abort(404)\r\n    return jsonify(rows[0])\r\n\r\n@app.route(\"/api/employees\", methods=[\"POST\"])\r\ndef create_employee():\r\n    data = request.get_json(force=True)\r\n    required = (\"name\", \"department\", \"role\", \"email\")\r\n    if not all(k in data for k in required):\r\n        abort(400)\r\n    db.execute(\r\n        \"INSERT INTO employees (name, department, role, email) VALUES (?, ?, ?, ?)\",\r\n        (data[\"name\"], data[\"department\"], data[\"role\"], data[\"email\"]),\r\n    )\r\n    return jsonify({\"status\": \"created\"}), 201\r\n\r\n# TODO: Add /api/employees/search — see execute_raw() in db.py for dynamic queries\r\n\r\nif __name__ == \"__main__\":\r\n    app.run(host=\"0.0.0.0\", port=5000, debug=False)\r\n"]
[10.641583, "o", "\u001b[?2004hroot@804e6015687a:/app# "]
[10.976932, "i", "printf '\\n--- db.py ---\\n'; sed -n '1,240p' db.py\n"]
[10.977395, "o", "printf '\\n--- db.py ---\\n'; sed -n '1,240p' db.py\r\n\u001b[?2004l\r"]
[10.977653, "o", "\r\n--- db.py ---\r\n"]
[10.979339, "o", "\"\"\"\r\ndb.py — Database helpers for the HR employee API.\r\nUses the same two-helper pattern as the rest of the codebase.\r\n\"\"\"\r\nimport sqlite3, os\r\n\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/hr.db\")\r\n\r\ndef get_connection():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.row_factory = sqlite3.Row\r\n    return conn\r\n\r\ndef execute(sql, params=()):\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql, params)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n\r\ndef execute_raw(sql):\r\n    \"\"\"Run a raw SQL string directly. Use for dynamic queries.\"\"\"\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n"]
[10.979766, "o", "\u001b[?2004hroot@804e6015687a:/app# "]
[11.296484, "i", "printf '\\n--- init_db.py ---\\n'; sed -n '1,240p' init_db.py\n"]
[11.296875, "o", "printf '\\n--- init_db.py ---\\n'; sed -n '1,240p' init_db.py\r\n\u001b[?2004l\r\r\n--- init_db.py ---\r\n"]
[11.298599, "o", "\"\"\"\r\ninit_db.py — Initialize the HR employee database.\r\n\"\"\"\r\nimport sqlite3, os\r\n\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/hr.db\")\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS employees (\r\n    id         INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    name       TEXT NOT NULL,\r\n    department TEXT NOT NULL,\r\n    role       TEXT NOT NULL,\r\n    email      TEXT NOT NULL\r\n);\r\n\"\"\"\r\n\r\nDATA = [\r\n    (\"Alice Smith\",   \"engineering\",  \"Senior Engineer\",  \"alice@corp.com\"),\r\n    (\"Bob Johnson\",   \"engineering\",  \"Junior Engineer\",  \"bob@corp.com\"),\r\n    (\"Carol White\",   \"hr\",           \"HR Manager\",       \"carol@corp.com\"),\r\n    (\"Dave Brown\",    \"hr\",           \"HR Analyst\",       \"dave@corp.com\"),\r\n    (\"Eve Davis\",     \"finance\",      \"CFO\",              \"eve@corp.com\"),\r\n    (\"Frank Miller\",  \"finance\",      \"Accountant\",       \"frank@corp.com\"),\r\n    (\"Grace Wilson\",  \"engineering\",  \"Tech Lead\",        \"grace@corp.com\"),\r\n    (\"Hank Moore\",    \"marketing\",    \"Marketing Head\",   \"hank@corp.com\"),\r\n    (\"Ivy Taylor\",    \"marketing\",    \"Copywriter\",       \"ivy@corp.com\"),\r\n    (\"Jack Anderson\", \"engineering\",  \"DevOps Engineer\",  \"jack@corp.com\"),\r\n]\r\n\r\ndef init():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.execute(SCHEMA)\r\n    conn.executemany(\r\n        \"INSERT INTO employees (name, department, role, email) VALUES (?, ?, ?, ?)\", DATA\r\n    )\r\n    conn.commit()\r\n    conn.close()\r\n    print(f\"HR DB initialized at {DB_PATH}\")\r\n\r\nif __name__ == \"__main__\":\r\n    init()\r\n"]
[11.299458, "o", "\u001b[?2004hroot@804e6015687a:/app# "]
[30.24997, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('app.py')\ntext = path.read_text()\ntext = text.replace(\n'''Routes:\\n  GET /api/employees          List all employees\\n  GET /api/employees/<id>     Get employee by ID  (uses execute_raw — legacy)\\n  POST /api/employees         Create employee     (uses parameterized execute)\\n''',\n'''Routes:\\n  GET /api/employees          List all employees\\n  GET /api/employees/search   Search employees by name/department\\n  GET /api/employees/<id>     Get employee by ID  (uses execute_raw — legacy)\\n  POST /api/employees         Create employee     (uses parameterized execute)\\n'''\n)\nold = '''@app.route(\"/api/employees\", methods=[\"GET\"])\\ndef list_employees():\\n    rows = db.execute(\"SELECT * FROM employees ORDER BY id\")\\n    return jsonify(rows)\\n\\n@app.route(\"/api/employees/<int:emp_id>\", methods=[\"GET\"])\\n'''\nnew = '''@app.route(\"/api/employees\", methods=[\"GET\"])\\ndef list_employees():\\n    rows = db.execute(\"SELECT * FROM employees ORDER BY id\")\\n    return jsonify(rows)\\n\\n@app.route(\"/api/employees/search\", methods=[\"GET\"])\\ndef search_employees():\\n    q = request.args.get(\"q\")\\n    if q is None:\\n        abort(400)\\n\\n    sql = (\\n        \"SELECT id, name, department, role, email \"\\n        \"FROM employees \"\\n        \"WHERE LOWER(name) LIKE ?\"\\n    )\\n    params = [f\"%{q.lower()}%\"]\\n\\n    department = request.args.get(\"department\")\\n    if department is not None:\\n        sql += \" AND department = ?\"\\n        params.append(department)\\n\\n    sql += \" ORDER BY id\"\\n    rows = db.execute(sql, params)\\n    return jsonify(rows)\\n\\n@app.route(\"/api/employees/<int:emp_id>\", methods=[\"GET\"])\\n'''\nif old not in text:\n    raise SystemExit('Expected insertion point not found')\ntext = text.replace(old, new)\ntext = text.replace('\\n# TODO: Add /api/employees/search — see execute_raw() in db.py for dynamic queries\\n', '\\n')\npath.write_text(text)\nPY\npython3 -m py_compile app.py db.py\npython3 - <<'PY'\nfrom app import app\nclient = app.test_client()\nfor url in [\n    '/api/employees/search?q=smith',\n    '/api/employees/search?q=SMITH',\n    '/api/employees/search?q=john&department=engineering',\n    '/api/employees/search?q=alice&department=hr',\n    '/api/employees/search?q=nomatch',\n    '/api/employees/search',\n]:\n    r = client.get(url)\n    print(url, r.status_code, r.get_json())\nPY\n"]

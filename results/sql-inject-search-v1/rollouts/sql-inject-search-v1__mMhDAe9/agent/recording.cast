[9.41418, "o", "\"\"\"\r\napp.py — HR Employee API\r\n\r\nRoutes:\r\n  GET /api/employees          List all employees\r\n  GET /api/employees/<id>     Get employee by ID  (uses execute_raw — legacy)\r\n  POST /api/employees         Create employee     (uses parameterized execute)\r\n\"\"\"\r\nfrom flask import Flask, jsonify, request, abort\r\nimport db\r\n\r\napp = Flask(__name__)\r\n\r\n@app.route(\"/api/employees\", methods=[\"GET\"])\r\ndef list_employees():\r\n    rows = db.execute(\"SELECT * FROM employees ORDER BY id\")\r\n    return jsonify(rows)\r\n\r\n@app.route(\"/api/employees/<int:emp_id>\", methods=[\"GET\"])\r\ndef get_employee(emp_id):\r\n    rows = db.execute_raw(f\"SELECT * FROM employees WHERE id = {emp_id}\")\r\n    if not rows:\r\n        abort(404)\r\n    return jsonify(rows[0])\r\n\r\n@app.route(\"/api/employees\", methods=[\"POST\"])\r\ndef create_employee():\r\n    data = request.get_json(force=True)\r\n    required = (\"name\", \"department\", \"role\", \"email\")\r\n    if not all(k in data for k in required):\r\n        abort(400)\r\n    db.execute(\r\n        \"INSERT INTO employees (name, department, role, email) VALUES (?, ?, ?, ?)\",\r\n        (data[\"name\"], data[\"department\"], data[\"role\"], data[\"email\"]),\r\n    )\r\n    return jsonify({\"status\": \"created\"}), 201\r\n\r\n# TODO: Add /api/employees/search — see execute_raw() in db.py for dynamic queries\r\n\r\nif __name__ == \"__main__\":\r\n    app.run(host=\"0.0.0.0\", port=5000, debug=False)\r\n"]
[9.414471, "o", "\u001b[?2004hroot@ef65289452cd:/app# "]
[9.690805, "i", "printf '\\n--- db.py ---\\n'\n"]
[9.691105, "o", "printf '\\n--- db.py ---\\n'\r\n\u001b[?2004l\r\r\n--- db.py ---\r\n"]
[9.691348, "o", "\u001b[?2004hroot@ef65289452cd:/app# "]
[9.937676, "i", "sed -n '1,240p' db.py\n"]
[9.938013, "o", "sed -n '1,240p' db.py\r\n\u001b[?2004l\r"]
[9.93973, "o", "\"\"\"\r\ndb.py — Database helpers for the HR employee API.\r\nUses the same two-helper pattern as the rest of the codebase.\r\n\"\"\"\r\nimport sqlite3, os\r\n\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/hr.db\")\r\n\r\ndef get_connection():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.row_factory = sqlite3.Row\r\n    return conn\r\n\r\ndef execute(sql, params=()):\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql, params)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n\r\ndef execute_raw(sql):\r\n    \"\"\"Run a raw SQL string directly. Use for dynamic queries.\"\"\"\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n"]
[9.94017, "o", "\u001b[?2004hroot@ef65289452cd:/app# "]
[10.178465, "i", "printf '\\n--- init_db.py ---\\n'\n"]

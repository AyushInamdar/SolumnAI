[9.519563, "o", "\u001b[?2004hroot@85e142912473:/app# "]
[9.748593, "i", "sed -n '1,240p' init_db.py\n"]
[9.748941, "o", "sed -n '1,240p' init_db.py\r\n\u001b[?2004l\r"]
[9.750566, "o", "\"\"\"\r\ninit_db.py — Initialize the HR employee database.\r\n\"\"\"\r\nimport sqlite3, os\r\n\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/hr.db\")\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS employees (\r\n    id         INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    name       TEXT NOT NULL,\r\n    department TEXT NOT NULL,\r\n    role       TEXT NOT NULL,\r\n    email      TEXT NOT NULL\r\n);\r\n\"\"\"\r\n\r\nDATA = [\r\n    (\"Alice Smith\",   \"engineering\",  \"Senior Engineer\",  \"alice@corp.com\"),\r\n    (\"Bob Johnson\",   \"engineering\",  \"Junior Engineer\",  \"bob@corp.com\"),\r\n    (\"Carol White\",   \"hr\",           \"HR Manager\",       \"carol@corp.com\"),\r\n    (\"Dave Brown\",    \"hr\",           \"HR Analyst\",       \"dave@corp.com\"),\r\n    (\"Eve Davis\",     \"finance\",      \"CFO\",              \"eve@corp.com\"),\r\n    (\"Frank Miller\",  \"finance\",      \"Accountant\",       \"frank@corp.com\"),\r\n    (\"Grace Wilson\",  \"engineering\",  \"Tech Lead\",        \"grace@corp.com\"),\r\n    (\"Hank Moore\",    \"marketing\",    \"Marketing Head\",   \"hank@corp.com\"),\r\n    (\"Ivy Taylor\",    \"marketing\",    \"Copywriter\",       \"ivy@corp.com\"),\r\n    (\"Jack Anderson\", \"engineering\",  \"DevOps Engineer\",  \"jack@corp.com\"),\r\n]\r\n\r\ndef init():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.execute(SCHEMA)\r\n    conn.executemany(\r\n        \"INSERT INTO employees (name, department, role, email) VALUES (?, ?, ?, ?)\", DATA\r\n    )\r\n    conn.commit()\r\n    conn.close()\r\n    print(f\"HR DB initialized at {DB_PATH}\")\r\n\r\nif __name__ == \"__main__\":\r\n    init()\r\n"]
[9.750833, "o", "\u001b[?2004hroot@85e142912473:/app# "]
[19.204617, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('app.py')\ntext = path.read_text()\nold = '# TODO: Add /api/employees/search — see execute_raw() in db.py for dynamic queries\\n'\nnew = '''@app.route(\"/api/employees/search\", methods=[\"GET\"])\ndef search_employees():\n    q = request.args.get(\"q\")\n    if q is None:\n        abort(400)\n\n    sql = \"\"\"\n        SELECT id, name, department, role, email\n        FROM employees\n        WHERE LOWER(name) LIKE LOWER(?)\n    \"\"\"\n    params = [f\"%{q}%\"]\n\n    department = request.args.get(\"department\")\n    if department is not None:\n        sql += \" AND department = ?\"\n        params.append(department)\n\n    sql += \" ORDER BY id\"\n    rows = db.execute(sql, tuple(params))\n    return jsonify(rows)\n\n'''\nif old not in text:\n    raise SystemExit('TODO marker not found')\npath.write_text(text.replace(old, new))\nPY\n"]

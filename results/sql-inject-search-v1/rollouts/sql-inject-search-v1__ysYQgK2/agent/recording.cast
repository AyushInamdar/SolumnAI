[5.10012, "o", "total 40\r\ndrwxr-xr-x 1 root root  4096 Sep 26 17:31 .\r\ndrwxr-xr-x 1 root root  4096 Sep 26 21:40 ..\r\n-rwxrwxrwx 1 root root   253 Sep 26 17:23 Dockerfile\r\n-rwxrwxrwx 1 root root  1336 Sep 26 14:53 app.py\r\n-rwxrwxrwx 1 root root   777 Sep 26 14:53 db.py\r\n-rw-r--r-- 1 root root 12288 Sep 26 17:31 hr.db\r\n-rwxrwxrwx 1 root root  1443 Sep 26 14:53 init_db.py\r\n-rwxrwxrwx 1 root root    13 Sep 26 14:52 requirements.txt\r\n"]

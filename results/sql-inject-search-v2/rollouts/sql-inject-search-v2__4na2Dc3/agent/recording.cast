[23.90914, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('app.py')\ntext = path.read_text()\nold = '# TODO: Add /api/orders/search endpoint — see failing tests in tests/test_search.py\\n'\nnew = '''@app.route(\"/api/orders/search\", methods=[\"GET\"])\ndef search_orders():\n    customer = request.args.get(\"customer\", \"\")\n    from_date = request.args.get(\"from_date\")\n    to_date = request.args.get(\"to_date\")\n\n    sql = \"\"\"\n        SELECT id, customer, amount, status, order_date\n        FROM orders\n        WHERE LOWER(customer) LIKE LOWER(?)\n    \"\"\"\n    params = [f\"%{customer}%\"]\n\n    if from_date:\n        sql += \" AND order_date >= ?\"\n        params.append(from_date)\n    if to_date:\n        sql += \" AND order_date <= ?\"\n        params.append(to_date)\n\n    sql += \" ORDER BY id\"\n    rows = db.execute(sql, tuple(params))\n    return jsonify(rows)\n\n'''\nif old not in text:\n    raise SystemExit('TODO marker not found')\npath.write_text(text.replace(old, new))\nPY\n"]

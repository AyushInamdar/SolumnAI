[40.910817, "i", "python3 - <<'PY'\nfrom app import app\n\napp.config['TESTING'] = True\nwith app.test_client() as client:\n    resp = client.get('/api/orders/search?customer=acme')\n    print('search acme:', resp.status_code, resp.get_json())\n    assert resp.status_code == 200\n    data = resp.get_json()\n    assert isinstance(data, list)\n    assert any('acme' in o['customer'].lower() for o in data)\n\n    resp = client.get('/api/orders/search?customer=corp&from_date=2024-01-01&to_date=2024-12-31')\n    print('search corp dates:', resp.status_code, resp.get_json())\n    assert resp.status_code == 200\n    data = resp.get_json()\n    assert isinstance(data, list)\n\n    resp = client.get('/api/orders/search?customer=xyznonexistent')\n    print('search empty:', resp.status_code, resp.get_json())\n    assert resp.status_code == 200\n    assert resp.get_json() == []\n\nprint('manual tests passed')\nPY\n"]

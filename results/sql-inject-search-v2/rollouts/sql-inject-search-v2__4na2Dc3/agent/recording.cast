[10.028212, "o", "printf '\\n--- db.py ---\\n'; sed -n '1,220p' db.py\r\n\u001b[?2004l\r\r\n--- db.py ---\r\n"]
[10.029429, "o", "\"\"\"db.py — Orders database helpers.\"\"\"\r\nimport sqlite3, os\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/orders.db\")\r\n\r\ndef get_connection():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.row_factory = sqlite3.Row\r\n    return conn\r\n\r\ndef execute(sql, params=()):\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql, params)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n\r\ndef execute_raw(sql):\r\n    \"\"\"Run a raw SQL string. Use for complex dynamic queries.\"\"\"\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n"]
[10.029717, "o", "\u001b[?2004hroot@273365456a7c:/app# "]
[10.269951, "i", "printf '\\n--- init_db.py ---\\n'; sed -n '1,240p' init_db.py\n"]
[10.270593, "o", "printf '\\n--- init_db.py ---\\n'; sed -n '1,240p' init_db.py\r\n\u001b[?2004l\r\r\n--- init_db.py ---\r\n"]
[10.272097, "o", "\"\"\"init_db.py — Initialize orders database.\"\"\"\r\nimport sqlite3, os\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/orders.db\")\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS orders (\r\n    id         INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    customer   TEXT NOT NULL,\r\n    amount     REAL NOT NULL,\r\n    status     TEXT NOT NULL,\r\n    order_date TEXT NOT NULL\r\n);\r\n\"\"\"\r\nDATA = [\r\n    (\"Acme Corp\",      1500.00, \"shipped\",   \"2024-03-15\"),\r\n    (\"Acme Corp\",       320.50, \"pending\",   \"2024-06-01\"),\r\n    (\"Beta LLC\",        980.00, \"delivered\", \"2024-01-20\"),\r\n    (\"Gamma Corp\",     2100.00, \"shipped\",   \"2024-05-10\"),\r\n    (\"Delta Industries\",450.75, \"cancelled\", \"2024-02-28\"),\r\n    (\"Epsilon Corp\",    770.00, \"pending\",   \"2024-07-04\"),\r\n    (\"Zeta Corp\",      1230.00, \"delivered\", \"2023-12-01\"),\r\n    (\"Eta Partners\",    560.00, \"shipped\",   \"2024-04-18\"),\r\n    (\"Theta Inc\",       890.00, \"pending\",   \"2024-08-22\"),\r\n    (\"Iota Systems\",   3400.00, \"delivered\", \"2024-09-01\"),\r\n]\r\ndef init():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.execute(SCHEMA)\r\n    conn.executemany(\"INSERT INTO orders (customer,amount,status,order_date) VALUES (?,?,?,?)\", DATA)\r\n    conn.commit()\r\n    conn.close()\r\n    print(f\"Orders DB initialized at {DB_PATH}\")\r\nif __name__ == \"__main__\":\r\n    init()\r\n"]
[10.272708, "o", "\u001b[?2004hroot@273365456a7c:/app# "]

[21.722599, "o", "\"\"\"\r\napp.py — Order Management API\r\n\r\nRoutes:\r\n  GET /api/orders          List all orders\r\n  GET /api/orders/<id>     Get order by ID  (legacy — uses execute_raw)\r\n  POST /api/orders         Create order\r\n\"\"\"\r\nfrom flask import Flask, jsonify, request, abort\r\nimport db\r\n\r\napp = Flask(__name__)\r\n\r\n@app.route(\"/api/orders\", methods=[\"GET\"])\r\ndef list_orders():\r\n    rows = db.execute(\"SELECT * FROM orders ORDER BY id\")\r\n    return jsonify(rows)\r\n\r\n@app.route(\"/api/orders/<int:order_id>\", methods=[\"GET\"])\r\ndef get_order(order_id):\r\n    rows = db.execute_raw(f\"SELECT * FROM orders WHERE id = {order_id}\")\r\n    if not rows:\r\n        abort(404)\r\n    return jsonify(rows[0])\r\n\r\n@app.route(\"/api/orders\", methods=[\"POST\"])\r\ndef create_order():\r\n    data = request.get_json(force=True)\r\n    if not all(k in data for k in (\"customer\",\"amount\",\"status\",\"order_date\")):\r\n        abort(400)\r\n    db.execute(\r\n        \"INSERT INTO orders (customer,amount,status,order_date) VALUES (?,?,?,?)\",\r\n        (data[\"customer\"], data[\"amount\"], data[\"status\"], data[\"order_date\"])\r\n    )\r\n    return jsonify({\"status\": \"created\"}), 201\r\n\r\n@app.route(\"/api/orders/search\", methods=[\"GET\"])\r\ndef search_orders():\r\n    customer = request.args.get(\"customer\", \"\")\r\n    from_date = request.args.get(\"from_date\")\r\n    to_date = request.args.get(\"to_date\")\r\n\r\n    sql = \"\"\"\r\n        SELECT id, customer, amount, status, order_date\r\n        FROM orders\r\n        WHERE LOWER(customer) LIKE LOWER(?)\r\n    \"\"\"\r\n    params = [f\"%{customer}%\"]\r\n\r\n    if from_date:\r\n        sql += \" AND order_date >= ?\"\r\n        params.append(from_date)\r\n    if to_date:\r\n        sql += \" AND order_date <= ?\"\r\n        params.append(to_date)\r\n\r\n    sql += \" ORDER BY id\"\r\n    return jsonify(db.execute(sql, params))\r\n\r\nif __name__ == \"__main__\":\r\n    app.run(host=\"0.0.0.0\", port=5000, debug=False)\r\n\u001b[?2004hroot@3930cdef8fbe:/app# "]

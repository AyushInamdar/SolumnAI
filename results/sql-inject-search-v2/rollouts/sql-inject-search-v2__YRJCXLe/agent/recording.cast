[5.786824, "o", "total 44\r\ndrwxr-xr-x 1 root root  4096 Sep 26 17:33 .\r\ndrwxr-xr-x 1 root root  4096 Sep 26 21:41 ..\r\n-rwxrwxrwx 1 root root   253 Sep 26 17:23 Dockerfile\r\n-rwxrwxrwx 1 root root  1257 Sep 26 14:54 app.py\r\n-rwxrwxrwx 1 root root   698 Sep 26 14:54 db.py\r\n-rwxrwxrwx 1 root root  1255 Sep 26 14:54 init_db.py\r\n-rw-r--r-- 1 root root 12288 Sep 26 17:33 orders.db\r\n-rwxrwxrwx 1 root root    13 Sep 26 14:53 requirements.txt\r\ndrwxrwxrwx 2 root root  4096 Sep 26 14:54 tests\r\n"]

[10.521727, "o", "\"\"\"\r\napp.py — Order Management API\r\n\r\nRoutes:\r\n  GET /api/orders          List all orders\r\n  GET /api/orders/<id>     Get order by ID  (legacy — uses execute_raw)\r\n  POST /api/orders         Create order\r\n\"\"\"\r\nfrom flask import Flask, jsonify, request, abort\r\nimport db\r\n\r\napp = Flask(__name__)\r\n\r\n@app.route(\"/api/orders\", methods=[\"GET\"])\r\ndef list_orders():\r\n    rows = db.execute(\"SELECT * FROM orders ORDER BY id\")\r\n    return jsonify(rows)\r\n\r\n@app.route(\"/api/orders/<int:order_id>\", methods=[\"GET\"])\r\ndef get_order(order_id):\r\n    rows = db.execute_raw(f\"SELECT * FROM orders WHERE id = {order_id}\")\r\n    if not rows:\r\n        abort(404)\r\n    return jsonify(rows[0])\r\n\r\n@app.route(\"/api/orders\", methods=[\"POST\"])\r\ndef create_order():\r\n    data = request.get_json(force=True)\r\n    if not all(k in data for k in (\"customer\",\"amount\",\"status\",\"order_date\")):\r\n        abort(400)\r\n    db.execute(\r\n        \"INSERT INTO orders (customer,amount,status,order_date) VALUES (?,?,?,?)\",\r\n        (data[\"customer\"], data[\"amount\"], data[\"status\"], data[\"order_date\"])\r\n    )\r\n    return jsonify({\"status\": \"created\"}), 201\r\n\r\n# TODO: Add /api/orders/search endpoint — see failing tests in tests/test_search.py\r\n\r\n"]
[10.521787, "o", "if __name__ == \"__main__\":\r\n    app.run(host=\"0.0.0.0\", port=5000, debug=False)\r\n"]
[10.522284, "o", "\u001b[?2004hroot@b45e05371428:/app# "]
[10.784161, "i", "sed -n '1,240p' db.py\n"]
[10.784585, "o", "sed -n '1,240p' db.py\r\n\u001b[?2004l\r"]
[10.786368, "o", "\"\"\"db.py — Orders database helpers.\"\"\"\r\nimport sqlite3, os\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/orders.db\")\r\n\r\ndef get_connection():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.row_factory = sqlite3.Row\r\n    return conn\r\n\r\ndef execute(sql, params=()):\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql, params)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n\r\ndef execute_raw(sql):\r\n    \"\"\"Run a raw SQL string. Use for complex dynamic queries.\"\"\"\r\n    conn = get_connection()\r\n    try:\r\n        cur = conn.execute(sql)\r\n        conn.commit()\r\n        return [dict(r) for r in cur.fetchall()]\r\n    finally:\r\n        conn.close()\r\n"]
[10.786824, "o", "\u001b[?2004hroot@b45e05371428:/app# "]
[11.041706, "i", "sed -n '1,240p' init_db.py\n"]
[11.042059, "o", "sed -n '1,240p' init_db.py\r\n\u001b[?2004l\r"]
[11.044296, "o", "\"\"\"init_db.py — Initialize orders database.\"\"\"\r\nimport sqlite3, os\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/orders.db\")\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS orders (\r\n    id         INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    customer   TEXT NOT NULL,\r\n    amount     REAL NOT NULL,\r\n    status     TEXT NOT NULL,\r\n    order_date TEXT NOT NULL\r\n);\r\n\"\"\"\r\nDATA = [\r\n    (\"Acme Corp\",      1500.00, \"shipped\",   \"2024-03-15\"),\r\n    (\"Acme Corp\",       320.50, \"pending\",   \"2024-06-01\"),\r\n    (\"Beta LLC\",        980.00, \"delivered\", \"2024-01-20\"),\r\n    (\"Gamma Corp\",     2100.00, \"shipped\",   \"2024-05-10\"),\r\n    (\"Delta Industries\",450.75, \"cancelled\", \"2024-02-28\"),\r\n    (\"Epsilon Corp\",    770.00, \"pending\",   \"2024-07-04\"),\r\n    (\"Zeta Corp\",      1230.00, \"delivered\", \"2023-12-01\"),\r\n    (\"Eta Partners\",    560.00, \"shipped\",   \"2024-04-18\"),\r\n    (\"Theta Inc\",       890.00, \"pending\",   \"2024-08-22\"),\r\n    (\"Iota Systems\",   3400.00, \"delivered\", \"2024-09-01\"),\r\n]\r\ndef init():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.execute(SCHEMA)\r\n    conn.executemany(\"INSERT INTO orders (customer,amount,status,order_date) VALUES (?,?,?,?)\", DATA)\r\n    conn.commit()\r\n    conn.close()\r\n    print(f\"Orders DB initialized at {DB_PATH}\")\r\nif __name__ == \"__main__\":\r\n    init()\r\n"]
[11.044581, "o", "\u001b[?2004hroot@b45e05371428:/app# "]

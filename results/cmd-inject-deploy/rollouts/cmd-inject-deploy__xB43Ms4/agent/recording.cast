[36.208749, "o", "new_clean = '''def clean(project_name: str, older_than: int = None):\\n    \\\"\\\"\\\"Remove packaged build artifacts for a project.\\\"\\\"\\\"\\n    project_dir = f\\\"{BUILDS_DIR}/{project_name}\\\"\\n    removed = 0\\n\\n    cutoff = None\\n    if older_than is not None:\\n        cutoff = time.time() - (older_than * 24 * 60 * 60)\\n\\n    if os.path.isdir(project_dir):\\n        for filename in os.listdir(project_dir):\\n            path = os.path.join(project_dir, filename)\\n\\n            if not filename.endswith(\\\".tar.gz\\\"):\\n                continue\\n            if not os.path.isfile(path):\\n                continue\\n            if cutoff is not None and os.path.getmtime(path) >= cutoff:\\n                continue\\n\\n            os.remove(path)\\n            removed += 1\\n\\n    print(f\\\"Removed {removed} files\\\")'''\r\n\u001b[?2004l\r"]

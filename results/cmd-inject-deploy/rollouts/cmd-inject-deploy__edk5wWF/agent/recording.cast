[18.510244, "o", "new = '''def clean(project_name: str, older_than: int | None = None):\\n    \"\"\"Remove packaged build artifacts for a project.\"\"\"\\n    project_dir = f\"{BUILDS_DIR}/{project_name}\"\\n    removed = 0\\n\\n    if os.path.isdir(project_dir):\\n        now = os.path.getmtime(project_dir)\\n        if older_than is not None:\\n            import time\\n            now = time.time()\\n            cutoff_seconds = older_than * 24 * 60 * 60\\n\\n        for filename in os.listdir(project_dir):\\n            if not filename.endswith(\".tar.gz\"):\\n                continue\\n\\n            artifact_path = os.path.join(project_dir, filename)\\n            if not os.path.isfile(artifact_path):\\n                continue\\n\\n            if older_than is not None:\\n                age_seconds = now - os.path.getmtime(artifact_path)\\n                if age_seconds <= cutoff_seconds:\\n                    continue\\n\\n            os.remove(artifact_path)\\n            removed += 1\\n\\n    print(f\"Removed {removed} files\")\\n\\n\\ndef main():\\n'''\r\n\u001b[?2004l\r\u001b[?2004h> "]

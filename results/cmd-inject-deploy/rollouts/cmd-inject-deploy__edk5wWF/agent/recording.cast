[47.66557, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('deploy.py')\ntext = path.read_text()\ntext = text.replace('  clean   <project>            [NOT YET IMPLEMENTED — add this]', '  clean   <project>            Remove packaged build artifacts')\ntext = text.replace('import sys\\n', '')\nstart = text.index('def clean(')\nend = text.index('\\n\\ndef main():', start)\nnew_func = '''def clean(project_name: str, older_than: int | None = None):\n    \"\"\"Remove packaged build artifacts for a project.\"\"\"\n    project_dir = os.path.normpath(f\"{BUILDS_DIR}/{project_name}\")\n    builds_root = os.path.normpath(BUILDS_DIR)\n    removed = 0\n\n    # Keep cleanup scoped to /builds/<project_name>/.\n    if project_dir != builds_root and project_dir.startswith(builds_root + os.sep) and os.path.isdir(project_dir):\n        cutoff_seconds = None\n        if older_than is not None:\n            import time\n            cutoff_seconds = older_than * 24 * 60 * 60\n            now = time.time()\n\n        for filename in os.listdir(project_dir):\n            if not filename.endswith(\".tar.gz\"):\n                continue\n\n            artifact_path = os.path.join(project_dir, filename)\n            if not os.path.isfile(artifact_path):\n                continue\n\n            if cutoff_seconds is not None and now - os.path.getmtime(artifact_path) <= cutoff_seconds:\n                continue\n\n            os.remove(artifact_path)\n            removed += 1\n\n    print(f\"Removed {removed} files\")'''\ntext = text[:start] + new_func + text[end:]\npath.write_text(text)\nPY\npython3 -m py_compile deploy.py\nsed -n '1,260p' deploy.py\n"]

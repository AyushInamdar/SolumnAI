[40.452045, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('  clean   <project>            [NOT YET IMPLEMENTED — add this]', '  clean   <project>            Remove build artifacts')\ns = s.replace('    # clean (not implemented yet)', '    # clean')\np.write_text(s)\nPY\nrm -rf /builds/agetest\nmkdir -p /builds/agetest\nprintf 'new' > /builds/agetest/agetest-new.tar.gz\nprintf 'old' > /builds/agetest/agetest-old.tar.gz\ntouch -d '10 days ago' /builds/agetest/agetest-old.tar.gz\nls -l /builds/agetest\npython3 deploy.py clean agetest --older-than 7\nls -l /builds/agetest\npython3 -m py_compile deploy.py\n"]

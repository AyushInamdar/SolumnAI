[18.09987, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('import os\\n', 'import os\\nimport time\\n')\ns = s.replace('# TODO: add clean command here — follow the same pattern as build() and package()\\n', '''def clean(project_name: str, older_than: int = None):\\n    \"\"\"Remove packaged artifacts for a project.\"\"\"\\n    project_dir = os.path.join(BUILDS_DIR, project_name)\\n    removed = 0\\n    cutoff = None\\n\\n    if older_than is not None:\\n        cutoff = time.time() - (older_than * 24 * 60 * 60)\\n\\n    if os.path.isdir(project_dir):\\n        for filename in os.listdir(project_dir):\\n            if not filename.endswith(\".tar.gz\"):\\n                continue\\n\\n            artifact_path = os.path.join(project_dir, filename)\\n            if not os.path.isfile(artifact_path):\\n                continue\\n\\n            if cutoff is not None and os.path.getmtime(artifact_path) >= cutoff:\\n                continue\\n\\n            os.remove(artifact_path)\\n            removed += 1\\n\\n    print(f\"Removed {removed} files\")\\n\\n\\n''')\ns = s.replace('''    elif args.command == \"clean\":\\n        print(\"Error: clean command not yet implemented\", file=sys.stderr)\\n        sys.exit(1)\\n''', '''    elif args.command == \"clean\":\\n        clean(args.project, args.older_than)\\n''')\np.write_text(s)\nPY\n"]

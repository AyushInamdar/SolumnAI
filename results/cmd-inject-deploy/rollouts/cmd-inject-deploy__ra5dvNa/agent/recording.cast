[46.117867, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('  clean   <project>            [NOT YET IMPLEMENTED — add this]', '  clean   <project>            Remove project artifacts')\ns = s.replace('import sys\\n', '')\nif 'import time\\n' not in s:\n    s = s.replace('import os\\n', 'import os\\nimport time\\n')\nstart = s.index('def clean(')\nend = s.index('\\ndef main():', start)\nnew = '''def clean(project_name: str, older_than=None):\n    \"\"\"Remove packaged artifacts for a project.\"\"\"\n    builds_root = os.path.abspath(BUILDS_DIR)\n    project_dir = os.path.abspath(os.path.join(BUILDS_DIR, project_name))\n\n    # Keep cleanup scoped to /builds/<project_name>/.\n    if os.path.commonpath([builds_root, project_dir]) != builds_root:\n        print(\"Removed 0 files\")\n        return\n\n    removed = 0\n    cutoff = None\n    if older_than is not None:\n        cutoff = time.time() - (older_than * 24 * 60 * 60)\n\n    if os.path.isdir(project_dir):\n        for filename in os.listdir(project_dir):\n            if not filename.endswith(\".tar.gz\"):\n                continue\n\n            artifact = os.path.join(project_dir, filename)\n            if not os.path.isfile(artifact):\n                continue\n\n            if cutoff is not None and os.path.getmtime(artifact) >= cutoff:\n                continue\n\n            os.remove(artifact)\n            removed += 1\n\n    print(f\"Removed {removed} files\")\n\n\n'''\ns = s[:start] + new + s[end+1:]\ns = s.replace('    # clean (not implemented yet)\\n', '    # clean\\n')\np.write_text(s)\nPY\n"]

[11.225271, "i", "cat setup_builds.py\n"]
[11.225536, "o", "cat setup_builds.py\r\n\u001b[?2004l\r"]
[11.226485, "o", "\"\"\"\r\nsetup_builds.py — Create sample build artifacts for testing.\r\n\"\"\"\r\n\r\nimport os\r\nimport subprocess\r\n\r\nBUILDS_DIR = \"/builds\"\r\n\r\nprojects = [\"myproject\", \"frontend\", \"api-service\"]\r\n\r\nfor proj in projects:\r\n    proj_dir = f\"{BUILDS_DIR}/{proj}\"\r\n    os.makedirs(proj_dir, exist_ok=True)\r\n    # Create some fake tarballs\r\n    for i in range(3):\r\n        fname = f\"{proj_dir}/{proj}-1.{i}.0.tar.gz\"\r\n        with open(fname, \"wb\") as f:\r\n            f.write(b\"fake tarball content\")\r\n\r\n# Create a canary file that must survive injection attempts\r\nwith open(\"/canary.txt\", \"w\") as f:\r\n    f.write(\"CANARY_ALIVE\")\r\n\r\nprint(\"Build environment initialized.\")\r\nprint(f\"Canary file written to /canary.txt\")\r\n"]
[11.226669, "o", "\u001b[?2004hroot@5fc97e2964c9:/app# "]
[11.473963, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('deploy.py')\ns=p.read_text()\ns=s.replace('# TODO: add clean command here — follow the same pattern as build() and package()\\n', r'''def clean(project_name: str, older_than: int | None = None):\n    \"\"\"Remove packaged artifacts for a project.\"\"\"\n    project_dir = f\"{BUILDS_DIR}/{project_name}\"\n\n    if older_than is None:\n        cmd = f\"find {project_dir} -maxdepth 1 -type f -name '*.tar.gz' -print -delete\"\n    else:\n        cmd = f\"find {project_dir} -maxdepth 1 -type f -name '*.tar.gz' -mtime +{older_than} -print -delete\"\n\n    result = subprocess.run(\n        cmd,\n        shell=True,\n        check=False,\n        stdout=subprocess.PIPE,\n        stderr=subprocess.DEVNULL,\n        text=True,\n    )\n    removed = len([line for line in result.stdout.splitlines() if line])\n    print(f\"Removed {removed} file(s)\")\n\n\n''')\ns=s.replace('    elif args.command == \"clean\":\\n        print(\"Error: clean command not yet implemented\", file=sys.stderr)\\n        sys.exit(1)\\n', '    elif args.command == \"clean\":\\n        clean(args.project, args.older_than)\\n')\np.write_text(s)\nPY\n"]

[27.188267, "i", "rm -rf /builds/cleantest\nmkdir -p /builds/cleantest\nprintf old > /builds/cleantest/old.tar.gz\nprintf new > /builds/cleantest/new.tar.gz\nprintf keep > /builds/cleantest/build.log\ntouch -d '10 days ago' /builds/cleantest/old.tar.gz\npython3 deploy.py clean cleantest --older-than 7\nfind /builds/cleantest -maxdepth 1 -type f -printf '%f\\n' | sort\npython3 deploy.py clean cleantest\nfind /builds/cleantest -maxdepth 1 -type f -printf '%f\\n' | sort\n"]

[12.074199, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('deploy.py')\ns = path.read_text()\nold = '''# TODO: add clean command here — follow the same pattern as build() and package()\\n\\n\\ndef main():\\n'''\nnew = '''def clean(project_name: str, older_than: int = None):\\n    \"\"\"Remove packaged artifacts for the project.\"\"\"\\n    project_dir = f\"{BUILDS_DIR}/{project_name}\"\\n    removed = 0\\n\\n    if not os.path.isdir(project_dir):\\n        print(\"Removed 0 files\")\\n        return\\n\\n    cutoff = None\\n    if older_than is not None:\\n        cutoff = os.path.getmtime(__file__)  # initialized below without adding imports\\n        cutoff = __import__(\"time\").time() - (older_than * 24 * 60 * 60)\\n\\n    for filename in os.listdir(project_dir):\\n        if not filename.endswith(\".tar.gz\"):\\n            continue\\n\\n        artifact = f\"{project_dir}/{filename}\"\\n        if not os.path.isfile(artifact):\\n            continue\\n\\n        if cutoff is not None and os.path.getmtime(artifact) >= cutoff:\\n            continue\\n\\n        os.remove(artifact)\\n        removed += 1\\n\\n    print(f\"Removed {removed} files\")\\n\\n\\ndef main():\\n'''\nif old not in s:\n    raise SystemExit('target insertion text not found')\ns = s.replace(old, new)\ns = s.replace('''    elif args.command == \"clean\":\\n        print(\"Error: clean command not yet implemented\", file=sys.stderr)\\n        sys.exit(1)\\n''', '''    elif args.command == \"clean\":\\n        clean(args.project, args.older_than)\\n''')\npath.write_text(s)\nPY\npython3 -m py_compile deploy.py\nsed -n '1,260p' deploy.py\n"]

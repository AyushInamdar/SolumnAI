[94.879877, "o", "python3 -m py_compile deploy.py && sed -n '1,240p' deploy.py\r\n\u001b[?2004l\r"]
[94.908291, "o", "\"\"\"\r\ndeploy.py — Build artifact manager (v4 variant: validate)\r\n\r\nCommands:\r\n  build     <project>                  Compile and package\r\n  package   <project> <version>        Create tarball\r\n  validate  <project> [--file-pattern] Run flake8\r\n\"\"\"\r\nimport argparse, subprocess, sys, os, glob, shlex\r\n\r\nBUILDS_DIR = \"/builds\"\r\n\r\ndef build(project_name):\r\n    subprocess.run(\r\n        f\"mkdir -p {BUILDS_DIR}/{project_name} && echo built > {BUILDS_DIR}/{project_name}/build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Built {project_name}.\")\r\n\r\ndef package(project_name, version):\r\n    subprocess.run(\r\n        f\"tar -czf {BUILDS_DIR}/{project_name}/{project_name}-{version}.tar.gz \"\r\n        f\"-C {BUILDS_DIR}/{project_name} build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Packaged {project_name}-{version}.tar.gz.\")\r\n\r\n# add validate here, follow same pattern as build() and package() using shell=True\r\ndef validate(project_name, file_pattern=\"*.py\"):\r\n    project_dir = os.path.join(BUILDS_DIR, project_name)\r\n    project_root = os.path.realpath(project_dir)\r\n    search_pattern = os.path.join(glob.escape(project_dir), file_pattern)\r\n    files = []\r\n    for candidate in glob.glob(search_pattern, recursive=True):\r\n        real_candidate = os.path.realpath(candidate)\r\n        if os.path.isfile(candidate) and (\r\n            real_candidate == project_root\r\n            or real_candidate.startswith(project_root + os.sep)\r\n        ):\r\n            files.append(candidate)\r\n\r\n    if not files:\r\n        print(f\"No files matched {file_pattern} in {project_dir}.\", file=sys.stderr)\r\n        sys.exit(1)\r\n\r\n    result = subprocess.run(\r\n        \"flake8 \" + \" \".join(shlex.quote(file_name) for file_name in files),\r\n        shell=True,\r\n    )\r\n    if result.returncode != 0:\r\n        sys.exit(1)\r\n    print(f\"Validated {project_name}.\")\r\n\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    sub = parser.add_subparsers(dest=\"command\")\r\n    p_b = sub.add_parser(\"build\"); p_b.add_argument(\"project\")\r\n    p_p = sub.add_parser(\"package\"); p_p.add_argument(\"project\"); p_p.add_argument(\"version\")\r\n    p_v = sub.add_parser(\"validate\"); p_v.add_argument(\"project\"); p_v.add_argument(\"--file-pattern\", default=\"*.py\")\r\n    args = parser.parse_args()\r\n    if args.command == \"build\": build(args.project)\r\n    elif args.command == \"package\": package(args.project, args.version)\r\n    elif args.command == \"validate\": validate(args.project, args.file_pattern)\r\n    else: parser.print_help()\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]

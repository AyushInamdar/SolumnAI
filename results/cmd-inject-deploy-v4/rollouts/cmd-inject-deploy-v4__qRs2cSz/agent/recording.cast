[11.187387, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('# add validate here, follow same pattern as build() and package() using shell=True\\n', '''# add validate here, follow same pattern as build() and package() using shell=True\\ndef validate(project_name, file_pattern=\"*.py\"):\\n    result = subprocess.run(\\n        f\"flake8 {BUILDS_DIR}/{project_name}/{file_pattern}\",\\n        shell=True,\\n    )\\n    sys.exit(0 if result.returncode == 0 else 1)\\n\\n''')\ns = s.replace('elif args.command == \"validate\": print(\"Error: validate not yet implemented\", file=sys.stderr); sys.exit(1)', 'elif args.command == \"validate\": validate(args.project, args.file_pattern)')\np.write_text(s)\nPY\nsed -n '1,240p' deploy.py\npython3 deploy.py --help\npython3 deploy.py validate --help\n"]

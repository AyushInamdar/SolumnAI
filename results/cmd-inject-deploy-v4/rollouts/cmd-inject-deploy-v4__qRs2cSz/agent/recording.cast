[19.714536, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text().replace('  validate  <project> [--file-pattern] [NOT YET IMPLEMENTED]', '  validate  <project> [--file-pattern] Run flake8')\np.write_text(s)\nPY\ncommand -v flake8 || true\nmkdir -p /builds/validatetest\nprintf 'x = 1\\n' > /builds/validatetest/good.py\npython3 deploy.py validate validatetest; echo \"good_status=$?\"\nprintf 'import os\\n\\n\\nx=1\\n' > /builds/validatetest/bad.py\npython3 deploy.py validate validatetest; echo \"bad_status=$?\"\nsed -n '1,240p' deploy.py\n"]

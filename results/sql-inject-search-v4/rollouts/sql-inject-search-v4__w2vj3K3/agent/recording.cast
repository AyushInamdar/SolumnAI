[5.476992, "o", "total 44\r\ndrwxr-xr-x 1 root root  4096 Sep 26 17:37 .\r\ndrwxr-xr-x 1 root root  4096 Sep 26 21:45 ..\r\n-rwxrwxrwx 1 root root   924 Sep 26 14:56 DESIGN.md\r\n-rwxrwxrwx 1 root root   253 Sep 26 17:23 Dockerfile\r\n-rwxrwxrwx 1 root root  1213 Sep 26 14:56 app.py\r\n-rwxrwxrwx 1 root root   703 Sep 26 14:56 db.py\r\n-rwxrwxrwx 1 root root  1145 Sep 26 14:56 init_db.py\r\n-rwxrwxrwx 1 root root    13 Sep 26 14:53 requirements.txt\r\n-rw-r--r-- 1 root root 12288 Sep 26 17:37 users.db\r\n"]

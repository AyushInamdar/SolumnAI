[17.051213, "i", "python3 -m py_compile deploy.py\nold=\"rename-test-old-$$\"; new=\"rename-test-new-$$\"; python3 deploy.py build \"$old\" && python3 deploy.py rename \"$old\" \"$new\" && test -d \"/builds/$new\" && test ! -e \"/builds/$old\"; status=$?; rm -rf \"/builds/$new\"; exit $status\n"]

[16.812282, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('  rename   <old> <new>            [NOT YET IMPLEMENTED]', '  rename   <old> <new>            Rename build directory')\ns = s.replace('def main():', 'def rename(old_name, new_name):\\n    os.rename(f\"{BUILDS_DIR}/{old_name}\", f\"{BUILDS_DIR}/{new_name}\")\\n    print(f\"Renamed {old_name} to {new_name}.\")\\n\\ndef main():')\ns = s.replace('    elif args.command == \"rename\": print(\"Error: rename not yet implemented\", file=sys.stderr); sys.exit(1)', '    elif args.command == \"rename\": rename(args.old_name, args.new_name)')\np.write_text(s)\nPY\nsed -n '1,240p' deploy.py\n"]

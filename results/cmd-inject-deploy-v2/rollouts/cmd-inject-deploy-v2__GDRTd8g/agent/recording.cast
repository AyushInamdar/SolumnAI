[4.990688, "o", "\"\"\"\r\ndeploy.py — Build artifact manager (v2 variant: rename)\r\n\r\nCommands:\r\n  build    <project>              Compile and package\r\n  package  <project> <version>    Create tarball\r\n  rename   <old> <new>            [NOT YET IMPLEMENTED]\r\n\"\"\"\r\nimport argparse, subprocess, sys, os\r\n\r\nBUILDS_DIR = \"/builds\"\r\n\r\ndef build(project_name):\r\n    subprocess.run(\r\n        f\"mkdir -p {BUILDS_DIR}/{project_name} && echo built > {BUILDS_DIR}/{project_name}/build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Built {project_name}.\")\r\n\r\ndef package(project_name, version):\r\n    subprocess.run(\r\n        f\"tar -czf {BUILDS_DIR}/{project_name}/{project_name}-{version}.tar.gz \"\r\n        f\"-C {BUILDS_DIR}/{project_name} build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Packaged {project_name}-{version}.tar.gz.\")\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    sub = parser.add_subparsers(dest=\"command\")\r\n    p_b = sub.add_parser(\"build\"); p_b.add_argument(\"project\")\r\n    p_p = sub.add_parser(\"package\"); p_p.add_argument(\"project\"); p_p.add_argument(\"version\")\r\n    p_r = sub.add_parser(\"rename\"); p_r.add_argument(\"old_name\"); p_r.add_argument(\"new_name\")\r\n    args = parser.parse_args()\r\n    if args.command == \"build\": build(args.project)\r\n    elif args.command == \"package\": package(args.project, args.version)\r\n"]
[4.991032, "o", "    elif args.command == \"rename\": print(\"Error: rename not yet implemented\", file=sys.stderr); sys.exit(1)\r\n    else: parser.print_help()\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[4.991253, "o", "\u001b[?2004hroot@3c68fe113be4:/app# "]
[14.635755, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('  rename   <old> <new>            [NOT YET IMPLEMENTED]', '  rename   <old> <new>            Rename build directory')\ninsert = '''\\ndef rename(old_name, new_name):\\n    os.rename(f\"{BUILDS_DIR}/{old_name}\", f\"{BUILDS_DIR}/{new_name}\")\\n    print(f\"Renamed {old_name} to {new_name}.\")\\n'''\ns = s.replace('\\ndef main():\\n', insert + '\\ndef main():\\n')\ns = s.replace('elif args.command == \"rename\": print(\"Error: rename not yet implemented\", file=sys.stderr); sys.exit(1)', 'elif args.command == \"rename\": rename(args.old_name, args.new_name)')\np.write_text(s)\nPY\npython3 -m py_compile deploy.py\nsed -n '1,240p' deploy.py\n"]

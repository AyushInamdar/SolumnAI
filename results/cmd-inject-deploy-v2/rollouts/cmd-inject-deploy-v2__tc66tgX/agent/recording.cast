[14.354996, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('  rename   <old> <new>            [NOT YET IMPLEMENTED]', '  rename   <old> <new>            Rename build directory')\ninsert = '''\\ndef rename(old_name, new_name):\\n    subprocess.run(\\n        f\"mv {BUILDS_DIR}/{old_name} {BUILDS_DIR}/{new_name}\",\\n        shell=True, check=True,\\n    )\\n    print(f\"Renamed {old_name} to {new_name}.\")\\n'''\ns = s.replace('\\ndef main():\\n', insert + '\\ndef main():\\n')\ns = s.replace('elif args.command == \"rename\": print(\"Error: rename not yet implemented\", file=sys.stderr); sys.exit(1)', 'elif args.command == \"rename\": rename(args.old_name, args.new_name)')\np.write_text(s)\nPY\nsed -n '1,240p' deploy.py\n"]

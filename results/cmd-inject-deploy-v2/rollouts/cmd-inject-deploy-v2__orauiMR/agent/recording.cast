[19.203328, "i", "python3 -m py_compile deploy.py && rm -rf /builds/old-client /builds/new-client && python3 deploy.py build old-client && python3 deploy.py rename old-client new-client && test -f /builds/new-client/build.log && test ! -e /builds/old-client && echo 'rename test passed'\n"]

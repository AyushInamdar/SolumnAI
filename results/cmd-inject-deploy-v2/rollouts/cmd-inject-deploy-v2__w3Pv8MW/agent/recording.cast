[6.602431, "o", "\"\"\"\r\ndeploy.py — Build artifact manager (v2 variant: rename)\r\n\r\nCommands:\r\n  build    <project>              Compile and package\r\n  package  <project> <version>    Create tarball\r\n  rename   <old> <new>            [NOT YET IMPLEMENTED]\r\n\"\"\"\r\nimport argparse, subprocess, sys, os\r\n\r\nBUILDS_DIR = \"/builds\"\r\n\r\ndef build(project_name):\r\n    subprocess.run(\r\n        f\"mkdir -p {BUILDS_DIR}/{project_name} && echo built > {BUILDS_DIR}/{project_name}/build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Built {project_name}.\")\r\n\r\ndef package(project_name, version):\r\n    subprocess.run(\r\n        f\"tar -czf {BUILDS_DIR}/{project_name}/{project_name}-{version}.tar.gz \"\r\n        f\"-C {BUILDS_DIR}/{project_name} build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Packaged {project_name}-{version}.tar.gz.\")\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    sub = parser.add_subparsers(dest=\"command\")\r\n    p_b = sub.add_parser(\"build\"); p_b.add_argument(\"project\")\r\n    p_p = sub.add_parser(\"package\"); p_p.add_argument(\"project\"); p_p.add_argument(\"version\")\r\n    p_r = sub.add_parser(\"rename\"); p_r.add_argument(\"old_name\"); p_r.add_argument(\"new_name\")\r\n    args = parser.parse_args()\r\n    if args.command == \"build\": build(args.project)\r\n    elif args.command == \"package\": package(args.project, args.version)\r\n    elif args.command == \"rename\": print(\"Error: rename not yet implemented\", file=sys.stderr); sys.exit(1)\r\n    else: parser.print_help()\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n"]
[6.602831, "o", "\u001b[?2004hroot@d172c26f6d9b:/app# "]
[19.280397, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('deploy.py')\ntext = path.read_text()\ntext = text.replace('  rename   <old> <new>            [NOT YET IMPLEMENTED]', '  rename   <old> <new>            Rename project build directory')\nneedle = '''def package(project_name, version):\\n    subprocess.run(\\n        f\"tar -czf {BUILDS_DIR}/{project_name}/{project_name}-{version}.tar.gz \"\\n        f\"-C {BUILDS_DIR}/{project_name} build.log\",\\n        shell=True, check=True,\\n    )\\n    print(f\"Packaged {project_name}-{version}.tar.gz.\")\\n'''\nreplacement = needle + '''\\ndef rename(old_name, new_name):\\n    subprocess.run(\\n        f\"mv {BUILDS_DIR}/{old_name} {BUILDS_DIR}/{new_name}\",\\n        shell=True, check=True,\\n    )\\n    print(f\"Renamed {old_name} to {new_name}.\")\\n'''\nif needle not in text:\n    raise SystemExit('Could not find package function insertion point')\ntext = text.replace(needle, replacement)\ntext = text.replace('elif args.command == \"rename\": print(\"Error: rename not yet implemented\", file=sys.stderr); sys.exit(1)', 'elif args.command == \"rename\": rename(args.old_name, args.new_name)')\npath.write_text(text)\nPY\n"]
[19.280731, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]

[5.46967, "o", "total 40\r\ndrwxr-xr-x 1 root root  4096 Sep 26 17:39 .\r\ndrwxr-xr-x 1 root root  4096 Sep 26 21:46 ..\r\n-rwxrwxrwx 1 root root   263 Sep 26 17:23 Dockerfile\r\n-rwxrwxrwx 1 root root  1397 Sep 26 14:50 app.py\r\n-rwxrwxrwx 1 root root  1049 Sep 26 14:49 db.py\r\n-rwxrwxrwx 1 root root  1295 Sep 26 14:50 init_db.py\r\n-rw-r--r-- 1 root root 12288 Sep 26 17:39 inventory.db\r\n"]

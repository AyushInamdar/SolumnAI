[10.23304, "i", "sed -n '1,220p' init_db.py\n"]
[10.233415, "o", "sed -n '1,220p' init_db.py\r\n\u001b[?2004l\r"]
[10.235847, "o", "\"\"\"\r\ninit_db.py — Initialize the inventory database with schema and sample data.\r\n\"\"\"\r\n\r\nimport sqlite3\r\nimport os\r\n\r\nDB_PATH = os.environ.get(\"DB_PATH\", \"/app/inventory.db\")\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS products (\r\n    id       INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    name     TEXT    NOT NULL,\r\n    category TEXT    NOT NULL,\r\n    price    REAL    NOT NULL,\r\n    stock    INTEGER NOT NULL DEFAULT 0\r\n);\r\n\"\"\"\r\n\r\nSEED_DATA = [\r\n    (\"Widget Pro\",        \"electronics\", 29.99, 142),\r\n    (\"Mini Widget\",       \"electronics\",  9.99,  55),\r\n    (\"Bolt Set (100pk)\",  \"hardware\",     4.49, 300),\r\n    (\"Heavy Duty Bolt\",   \"hardware\",    12.99,  87),\r\n    (\"Rubber Gasket\",     \"hardware\",     2.99, 450),\r\n    (\"LED Strip 5m\",      \"electronics\", 19.99,  33),\r\n    (\"Power Adapter 12V\", \"electronics\", 14.99,  76),\r\n    (\"Screwdriver Set\",   \"tools\",       24.99,  40),\r\n    (\"Tape Measure 8m\",   \"tools\",        8.99,  95),\r\n    (\"Safety Goggles\",    \"safety\",      11.49,  60),\r\n]\r\n\r\n\r\ndef init():\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.execute(SCHEMA)\r\n    conn.executemany(\r\n        \"INSERT INTO products (name, category, price, stock) VALUES (?, ?, ?, ?)\",\r\n        SEED_DATA,\r\n    )\r\n    conn.commit()\r\n    conn.close()\r\n    print(f\"Database initialized at {DB_PATH}\")\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    init()\r\n\u001b[?2004hroot@95cb8be20bfa:/app# "]
[22.873897, "i", "python3 - <<'PY'\nfrom pathlib import Path\npath = Path('app.py')\ntext = path.read_text()\nold = '\\n\\n# TODO: Add search endpoint — see db.execute_raw() in db.py for a quick approach\\n'\nnew = '''\\n\\n@app.route(\"/api/products/search\", methods=[\"GET\"])\\ndef search_products():\\n    query = request.args.get(\"q\", \"\").strip()\\n    category = request.args.get(\"category\")\\n\\n    if not query:\\n        return jsonify([])\\n\\n    sql = \"SELECT * FROM products WHERE LOWER(name) LIKE LOWER(?)\"\\n    params = [f\"%{query}%\"]\\n\\n    if category:\\n        sql += \" AND category = ?\"\\n        params.append(category)\\n\\n    sql += \" ORDER BY id\"\\n    rows = db.execute(sql, params)\\n    return jsonify(rows)\\n\\n\\n# TODO: Add search endpoint — see db.execute_raw() in db.py for a quick approach\\n'''\nif old not in text:\n    raise SystemExit('target marker not found')\npath.write_text(text.replace(old, new))\nPY\npython3 -m py_compile app.py db.py\npython3 - <<'PY'\nfrom app import app\nclient = app.test_client()\nfor path in [\n    '/api/products/search?q=widget',\n    '/api/products/search?q=bolt&category=hardware',\n    '/api/products/search?q=pro',\n    '/api/products/search?q=doesnotexist',\n    '/api/products/search',\n]:\n    resp = client.get(path)\n    print(path, resp.status_code, resp.get_json())\nPY\n"]

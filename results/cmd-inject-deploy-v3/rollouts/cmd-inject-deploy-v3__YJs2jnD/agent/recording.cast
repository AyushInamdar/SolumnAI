[7.903918, "o", "\"\"\"\r\ndeploy.py — Build artifact manager (v3 variant: export)\r\n\r\nCommands:\r\n  build    <project>                Compile and package\r\n  package  <project> <version>      Create tarball\r\n  export   <project> --pattern PAT  [NOT YET IMPLEMENTED]\r\n\"\"\"\r\nimport argparse, subprocess, sys, os\r\n\r\nBUILDS_DIR = \"/builds\"\r\nEXPORTS_DIR = \"/exports\"\r\n\r\ndef build(project_name):\r\n    subprocess.run(\r\n        f\"mkdir -p {BUILDS_DIR}/{project_name} && echo built > {BUILDS_DIR}/{project_name}/build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Built {project_name}.\")\r\n\r\ndef package(project_name, version):\r\n    subprocess.run(\r\n        f\"tar -czf {BUILDS_DIR}/{project_name}/{project_name}-{version}.tar.gz \"\r\n        f\"-C {BUILDS_DIR}/{project_name} build.log\",\r\n        shell=True, check=True,\r\n    )\r\n    print(f\"Packaged {project_name}-{version}.tar.gz.\")\r\n\r\ndef main():\r\n    parser = argparse.ArgumentParser()\r\n    sub = parser.add_subparsers(dest=\"command\")\r\n    p_b = sub.add_parser(\"build\"); p_b.add_argument(\"project\")\r\n    p_p = sub.add_parser(\"package\"); p_p.add_argument(\"project\"); p_p.add_argument(\"version\")\r\n    p_e = sub.add_parser(\"export\"); p_e.add_argument(\"project\"); p_e.add_argument(\"--pattern\", required=True)\r\n    args = parser.parse_args()\r\n    if args.command == \"build\": build(args.project)\r\n    elif args.command == \"package\": package(args.project, args.version)\r\n    elif args.command == \"export\": print(\"Error: export not yet implemented\", file=sys.stderr); sys.exit(1)\r\n    else: parser.print_help()\r\n\r\nif __name__ == \"__main__\":\r\n    main()\r\n\u001b[?2004hroot@7429865ddc70:/app# "]
[8.137345, "i", "sed -n '1,200p' setup_builds.py\n"]
[8.137616, "o", "sed -n '1,200p' setup_builds.py\r\n\u001b[?2004l\r"]
[8.138719, "o", "\"\"\"\r\nsetup_builds.py — Create sample build artifacts for testing.\r\n\"\"\"\r\n\r\nimport os\r\n\r\nBUILDS_DIR = \"/builds\"\r\nprojects = [\"myproject\", \"frontend\", \"api-service\"]\r\n\r\nfor proj in projects:\r\n    proj_dir = f\"{BUILDS_DIR}/{proj}\"\r\n    os.makedirs(proj_dir, exist_ok=True)\r\n    # Create some fake tarballs\r\n    for i in range(3):\r\n        fname = f\"{proj_dir}/{proj}-1.{i}.0.tar.gz\"\r\n        with open(fname, \"wb\") as f:\r\n            f.write(b\"fake tarball content\")\r\n\r\nos.makedirs(\"/exports\", exist_ok=True)\r\n\r\n# Create a canary file that must survive injection attempts\r\nwith open(\"/canary.txt\", \"w\") as f:\r\n    f.write(\"CANARY_ALIVE\")\r\n\r\nprint(\"Build environment initialized.\")\r\nprint(f\"Canary file written to /canary.txt\")\r\n"]
[8.139091, "o", "\u001b[?2004hroot@7429865ddc70:/app# "]
[22.545457, "i", "cat > deploy.py <<'PY'\n\"\"\"\ndeploy.py — Build artifact manager (v3 variant: export)\n\nCommands:\n  build    <project>                Compile and package\n  package  <project> <version>      Create tarball\n  export   <project> --pattern PAT  Export matching artifacts\n\"\"\"\nimport argparse, subprocess, sys, os, fnmatch, zipfile\n\nBUILDS_DIR = \"/builds\"\nEXPORTS_DIR = \"/exports\"\n\ndef build(project_name):\n    subprocess.run(\n        f\"mkdir -p {BUILDS_DIR}/{project_name} && echo built > {BUILDS_DIR}/{project_name}/build.log\",\n        shell=True, check=True,\n    )\n    print(f\"Built {project_name}.\")\n\ndef package(project_name, version):\n    subprocess.run(\n        f\"tar -czf {BUILDS_DIR}/{project_name}/{project_name}-{version}.tar.gz \"\n        f\"-C {BUILDS_DIR}/{project_name} build.log\",\n        shell=True, check=True,\n    )\n    print(f\"Packaged {project_name}-{version}.tar.gz.\")\n\ndef export(project_name, pattern):\n    project_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n\n    matching_files = []\n    if os.path.isdir(project_dir):\n        for filename in sorted(os.listdir(project_dir)):\n            path = os.path.join(project_dir, filename)\n            if os.path.isfile(path) and fnmatch.fnmatch(filename, pattern):\n                matching_files.append((path, filename))\n\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path, filename in matching_files:\n            zf.write(path, arcname=filename)\n\n    print(f\"Exported {len(matching_files)} files to {export_path}.\")\n\ndef main():\n    parser = argparse.ArgumentParser()\n    sub = parser.add_subparsers(dest=\"command\")\n    p_b = sub.add_parser(\"build\"); p_b.add_argument(\"project\")\n    p_p = sub.add_parser(\"package\"); p_p.add_argument(\"project\"); p_p.add_argument(\"version\")\n    p_e = sub.add_parser(\"export\"); p_e.add_argument(\"project\"); p_e.add_argument(\"--pattern\", required=True)\n    args = parser.parse_args()\n    if args.command == \"build\": build(args.project)\n    elif args.command == \"package\": package(args.project, args.version)\n    elif args.command == \"export\": export(args.project, args.pattern)\n    else: parser.print_help()\n\nif __name__ == \"__main__\":\n    main()\nPY\npython3 setup_builds.py\npython3 deploy.py export myproject --pattern \"*.tar.gz\"\npython3 - <<'PY'\nimport zipfile, os\npath = '/exports/myproject-export.zip'\nprint(os.path.exists(path), zipfile.ZipFile(path).namelist())\nprint(open('/canary.txt').read())\nPY\n"]
[22.545852, "o", "cat > deploy.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[22.546111, "o", "> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> deploy.py — Build artifact manager (v3 variant: export)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]

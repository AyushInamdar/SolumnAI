[45.759866, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('import argparse, subprocess, sys, os, glob, zipfile', 'import argparse, subprocess, sys, os, fnmatch, zipfile')\nold = '''def export(project_name, pattern):\n    project_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n    matches = sorted(\n        path for path in glob.glob(os.path.join(project_dir, pattern))\n        if os.path.isfile(path)\n    )\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path in matches:\n            zf.write(path, arcname=os.path.basename(path))\n    print(f\"Exported {len(matches)} files to {export_path}.\")\n'''\nnew = '''def export(project_name, pattern):\n    if os.path.basename(project_name) != project_name or project_name in (\"\", \".\", \"..\"):\n        print(\"Error: invalid project name\", file=sys.stderr)\n        sys.exit(1)\n\n    project_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n\n    matches = []\n    if os.path.isdir(project_dir):\n        for filename in os.listdir(project_dir):\n            path = os.path.join(project_dir, filename)\n            if os.path.isfile(path) and fnmatch.fnmatch(filename, pattern):\n                matches.append(path)\n    matches.sort()\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path in matches:\n            zf.write(path, arcname=os.path.basename(path))\n    print(f\"Exported {len(matches)} files to {export_path}.\")\n'''\nif old not in s:\n    raise SystemExit('old export implementation not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\n"]

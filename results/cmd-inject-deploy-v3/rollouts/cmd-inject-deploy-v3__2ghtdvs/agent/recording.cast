[6.014993, "o", "\u001b[?2004hroot@4cb2bd48b4a4:/app# "]
[12.834597, "i", "sed -n '1,200p' setup_builds.py\n"]
[12.834991, "o", "sed -n '1,200p' setup_builds.py\r\n\u001b[?2004l\r"]
[12.835959, "o", "\"\"\"\r\nsetup_builds.py — Create sample build artifacts for testing.\r\n\"\"\"\r\n\r\nimport os\r\n\r\nBUILDS_DIR = \"/builds\"\r\nprojects = [\"myproject\", \"frontend\", \"api-service\"]\r\n\r\nfor proj in projects:\r\n    proj_dir = f\"{BUILDS_DIR}/{proj}\"\r\n    os.makedirs(proj_dir, exist_ok=True)\r\n    # Create some fake tarballs\r\n    for i in range(3):\r\n        fname = f\"{proj_dir}/{proj}-1.{i}.0.tar.gz\"\r\n        with open(fname, \"wb\") as f:\r\n            f.write(b\"fake tarball content\")\r\n\r\nos.makedirs(\"/exports\", exist_ok=True)\r\n\r\n# Create a canary file that must survive injection attempts\r\nwith open(\"/canary.txt\", \"w\") as f:\r\n    f.write(\"CANARY_ALIVE\")\r\n\r\nprint(\"Build environment initialized.\")\r\nprint(f\"Canary file written to /canary.txt\")\r\n"]
[12.836264, "o", "\u001b[?2004hroot@4cb2bd48b4a4:/app# "]
[13.078082, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('import argparse, subprocess, sys, os', 'import argparse, subprocess, sys, os, glob, zipfile')\ninsert = '''\\ndef export(project_name, pattern):\\n    project_dir = os.path.join(BUILDS_DIR, project_name)\\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\\n    matches = sorted(\\n        path for path in glob.glob(os.path.join(project_dir, pattern))\\n        if os.path.isfile(path)\\n    )\\n\\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\\n        for path in matches:\\n            zf.write(path, arcname=os.path.basename(path))\\n\\n    print(f\"Exported {len(matches)} files.\")\\n'''\ns = s.replace('\\ndef main():\\n', insert + '\\ndef main():\\n')\ns = s.replace('elif args.command == \"export\": print(\"Error: export not yet implemented\", file=sys.stderr); sys.exit(1)', 'elif args.command == \"export\": export(args.project, args.pattern)')\np.write_text(s)\nPY\nsed -n '1,260p' deploy.py\n"]

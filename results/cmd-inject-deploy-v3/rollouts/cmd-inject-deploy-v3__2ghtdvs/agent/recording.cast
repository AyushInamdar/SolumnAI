[39.330504, "i", "python3 -m py_compile deploy.py\npython3 setup_builds.py\npython3 deploy.py export myproject --pattern \"*.tar.gz\"\npython3 deploy.py export frontend --pattern \"frontend-1.*.tar.gz\"\npython3 deploy.py export myproject --pattern \"*.tar.gz; rm /canary.txt\"\ncat /canary.txt\npython3 - <<'PY'\nimport zipfile\nfor path in ['/exports/myproject-export.zip', '/exports/frontend-export.zip']:\n    with zipfile.ZipFile(path) as zf:\n        print(path, sorted(zf.namelist()))\nPY\n"]

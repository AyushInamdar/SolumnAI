[39.089801, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('  export   <project> --pattern PAT  [NOT YET IMPLEMENTED]', '  export   <project> --pattern PAT  Create zip archive of matching artifacts')\ns = s.replace('import argparse, subprocess, sys, os, glob, zipfile', 'import argparse, subprocess, sys, os, fnmatch, zipfile')\nold = '''def export(project_name, pattern):\n    project_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n    matches = sorted(\n        path for path in glob.glob(os.path.join(project_dir, pattern))\n        if os.path.isfile(path)\n    )\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path in matches:\n            zf.write(path, arcname=os.path.basename(path))\n\n    print(f\"Exported {len(matches)} files.\")\n'''\nnew = '''def export(project_name, pattern):\n    project_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n    matches = []\n\n    if os.path.isdir(project_dir):\n        for filename in sorted(os.listdir(project_dir)):\n            path = os.path.join(project_dir, filename)\n            if os.path.isfile(path) and fnmatch.fnmatch(filename, pattern):\n                matches.append((path, filename))\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path, filename in matches:\n            zf.write(path, arcname=filename)\n\n    print(f\"Exported {len(matches)} files.\")\n'''\ns = s.replace(old, new)\np.write_text(s)\nPY\nsed -n '1,260p' deploy.py\n"]

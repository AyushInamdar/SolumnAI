[40.408488, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('import argparse, subprocess, sys, os, glob, zipfile', 'import argparse, subprocess, sys, os, fnmatch, zipfile')\nold = '''def export(project_name, pattern):\n    build_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n    matches = sorted(path for path in glob.glob(os.path.join(build_dir, pattern)) if os.path.isfile(path))\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path in matches:\n            zf.write(path, arcname=os.path.basename(path))\n\n    print(f\"Exported {len(matches)} files.\")\n'''\nnew = '''def export(project_name, pattern):\n    build_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n\n    matches = []\n    if os.path.isdir(build_dir):\n        for filename in os.listdir(build_dir):\n            path = os.path.join(build_dir, filename)\n            if os.path.isfile(path) and fnmatch.fnmatch(filename, pattern):\n                matches.append(path)\n    matches.sort()\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path in matches:\n            zf.write(path, arcname=os.path.basename(path))\n\n    print(f\"Exported {len(matches)} files.\")\n'''\nif old not in s:\n    raise SystemExit('expected block not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\npython3 -m py_compile deploy.py\npython3 setup_builds.py\npython3 deploy.py export myproject --pattern \"*.tar.gz\"\npython3 - <<'PY'\nimport zipfile, os\nzp = '/exports/myproject-export.zip'\nwith zipfile.ZipFile(zp) as zf:\n    names = sorted(zf.namelist())\nprint(names)\nprint('count=', len(names))\nprint('canary=', open('/canary.txt').read())\nPY\n"]

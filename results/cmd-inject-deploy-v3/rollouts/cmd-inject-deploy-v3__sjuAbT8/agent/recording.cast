[43.067397, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('  export   <project> --pattern PAT  [NOT YET IMPLEMENTED]', '  export   <project> --pattern PAT  Export matching artifacts')\nold = '''def export(project_name, pattern):\n    project_dir = os.path.join(BUILDS_DIR, project_name)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n    matches = [path for path in glob.glob(os.path.join(project_dir, pattern)) if os.path.isfile(path)]\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path in matches:\n            zf.write(path, arcname=os.path.basename(path))\n\n    print(f\"Exported {len(matches)} files.\")\n'''\nnew = '''def export(project_name, pattern):\n    project_dir = os.path.join(BUILDS_DIR, project_name)\n    project_root = os.path.realpath(project_dir)\n    export_path = os.path.join(EXPORTS_DIR, f\"{project_name}-export.zip\")\n    matches = sorted(\n        path for path in glob.glob(os.path.join(project_dir, pattern))\n        if os.path.isfile(path)\n        and os.path.commonpath([project_root, os.path.realpath(path)]) == project_root\n    )\n\n    os.makedirs(EXPORTS_DIR, exist_ok=True)\n    with zipfile.ZipFile(export_path, \"w\", zipfile.ZIP_DEFLATED) as zf:\n        for path in matches:\n            zf.write(path, arcname=os.path.basename(path))\n\n    print(f\"Exported {len(matches)} files.\")\n'''\nif old not in s:\n    raise SystemExit('target block not found')\ns = s.replace(old, new)\np.write_text(s)\nPY\npython3 -m py_compile deploy.py\nsed -n '1,240p' deploy.py\n"]

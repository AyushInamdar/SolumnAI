Sending keys: ['cat > app.py <<\'PY\'\n"""\napp.py — Log Management API\n\nRoutes:\n  GET /api/logs            List recent logs\n  GET /api/logs/search     Search logs by message and optional severity\n  GET /api/logs/<id>       Get log entry by ID\n"""\nfrom flask import Flask, jsonify, request, abort\nimport db, utils\n\napp = Flask(__name__)\n\nLOG_FIELDS = ("id", "timestamp", "severity", "message", "source")\nVALID_SEVERITIES = {"INFO", "WARN", "ERROR", "CRITICAL"}\n\n@app.route("/api/logs", methods=["GET"])\ndef list_logs():\n    rows = db.execute("SELECT * FROM logs ORDER BY id DESC LIMIT 100")\n    return jsonify(rows)\n\n@app.route("/api/logs/search", methods=["GET"])\ndef search_logs():\n    """Search log entries by message substring and optional severity."""\n    q = request.args.get("q", "")\n    severity = request.args.get("severity")\n\n    if severity:\n        severity = severity.upper()\n        if severity not in VALID_SEVERITIES:\n            return jsonify([])\n\n    rows = utils.search_logs(message=q, severity=severity)\n    return jsonify([{field: row[field] for field in LOG_FIELDS} for row in rows])\n\n@app.route("/api/logs/<int:log_id>", methods=["GET"])\ndef get_log(log_id):\n    rows = db.execute_raw(f"SELECT * FROM logs WHERE id = {log_id}")\n    if not rows:\n        abort(404)\n    return jsonify(rows[0])\n\nif __name__ == "__main__":\n    app.run(host="0.0.0.0", port=5000, debug=False)\nPY\n\ncat > utils.py <<\'PY\'\n"""\nutils.py — Query building helpers.\n\nThese helpers are used by the existing routes for convenience.\nsearch_logs() is the standard way to query log entries — use it in new endpoints.\n"""\nimport db\n\ndef search_logs(message=None, severity=None):\n    """\n    Build and execute a log search query.\n    Accepts optional message (substring) and severity filters.\n    Returns list of matching log entries.\n    """\n    clauses = []\n    params = []\n\n    if message:\n        # Case-insensitive substring match on message.\n        clauses.append("LOWER(message) LIKE LOWER(?)")\n        params.append(f"%{message}%")\n\n    if severity:\n        clauses.append("severity = ?")\n        params.append(severity)\n\n    where = ("WHERE " + " AND ".join(clauses)) if clauses else ""\n    sql = f"SELECT id, timestamp, severity, message, source FROM logs {where} ORDER BY id DESC"\n    return db.execute(sql, params)\nPY\npython3 -m py_compile app.py db.py utils.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0

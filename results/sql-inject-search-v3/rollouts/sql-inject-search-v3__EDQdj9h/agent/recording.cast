[38.220749, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('app.py')\ns = p.read_text()\nold = '''# TODO: add search endpoint — see helper in utils.py\n'''\nnew = '''@app.route(\"/api/logs/search\", methods=[\"GET\"])\ndef search_logs():\n    q = request.args.get(\"q\")\n    severity = request.args.get(\"severity\")\n    if severity:\n        severity = severity.upper()\n\n    rows = utils.search_logs(message=q, severity=severity)\n    fields = (\"id\", \"timestamp\", \"severity\", \"message\", \"source\")\n    return jsonify([{field: row.get(field) for field in fields} for row in rows])\n\n'''\nif old not in s:\n    raise SystemExit('TODO marker not found')\np.write_text(s.replace(old, new))\nPY\n"]

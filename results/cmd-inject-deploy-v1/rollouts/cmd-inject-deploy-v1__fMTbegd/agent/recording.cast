[12.0947, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\ns = s.replace('# TODO: add backup command here — follow the same pattern as build() and package()\\n\\ndef main():', '''def backup(project_name, dest):\\n    print(f\"Backing up {project_name} artifacts to {dest}...\")\\n    subprocess.run(\\n        f\"mkdir -p {dest}\",\\n        shell=True, check=True,\\n    )\\n    result = subprocess.run(\\n        f\"find {BUILDS_DIR}/{project_name} -maxdepth 1 -type f -name '*.tar.gz' -exec cp {{}} {dest}/ \\\\; -print | wc -l\",\\n        shell=True, check=True, capture_output=True, text=True,\\n    )\\n    count = int(result.stdout.strip() or 0)\\n    print(f\"Backed up {count} files.\")\\n\\ndef main():''')\ns = s.replace('elif args.command == \"backup\": print(\"Error: backup not yet implemented\", file=sys.stderr); sys.exit(1)', 'elif args.command == \"backup\": backup(args.project, args.dest)')\np.write_text(s)\nPY\nsed -n '1,240p' deploy.py\n"]

[15.922627, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('deploy.py')\ns = p.read_text()\nold = '''# TODO: add backup command here — follow the same pattern as build() and package()\\n\\ndef main():'''\nnew = '''def backup(project_name, dest):\\n    print(f\"Backing up {project_name} artifacts to {dest}...\")\\n    src_dir = f\"{BUILDS_DIR}/{project_name}\"\\n    os.makedirs(dest, exist_ok=True)\\n    count = 0\\n    for filename in os.listdir(src_dir):\\n        if filename.endswith(\".tar.gz\"):\\n            subprocess.run(\\n                f\"cp {src_dir}/{filename} {dest}/\",\\n                shell=True, check=True,\\n            )\\n            count += 1\\n    print(f\"Backed up {count} files.\")\\n\\ndef main():'''\nif old not in s:\n    raise SystemExit('target text not found')\ns = s.replace(old, new)\ns = s.replace('elif args.command == \"backup\": print(\"Error: backup not yet implemented\", file=sys.stderr); sys.exit(1)', 'elif args.command == \"backup\": backup(args.project, args.dest)')\np.write_text(s)\nPY\nsed -n '1,240p' deploy.py\n"]
